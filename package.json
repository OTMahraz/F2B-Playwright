{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Framework d'automatisation Playwright professionnel et modulaire",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:api": "playwright test --grep @api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:reporter": "playwright show-report",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "lint": "eslint --ext .ts src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf ./test-results ./playwright-report ./allure-results ./allure-report ./coverage"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.1",
    "typescript": "^5.7.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.8.0"
  }
}
